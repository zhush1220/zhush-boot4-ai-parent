<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zhush</groupId>
        <artifactId>zhush-boot4-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>zhush-module-ai</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.zhush</groupId>
            <artifactId>zhush-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhush</groupId>
            <artifactId>zhush-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhush</groupId>
            <artifactId>zhush-spring-boot-starter-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhush</groupId>
            <artifactId>zhush-spring-boot-starter-satoken</artifactId>
        </dependency>

        <!-- AgentScope 智能体框架：统一接入 zhush-module-ai -->
        <dependency>
            <groupId>com.zhush</groupId>
            <artifactId>zhush-spring-boot-starter-agentscope</artifactId>
        </dependency>

        <!-- 文件存储门面与文档解析（对话多能力：产物上传 / parseDocument） -->
        <dependency>
            <groupId>com.zhush</groupId>
            <artifactId>zhush-spring-boot-starter-file</artifactId>
        </dependency>

        <!-- Word 生成（XWPF）：版本与 Tika 传递的 POI 对齐 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- PDF 生成（OpenPDF，内置 CJK 字体） -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
        </dependency>

        <!-- 测试基础设施（JUnit5 + Mockito + AssertJ） -->
        <dependency>
            <groupId>com.zhush</groupId>
            <artifactId>zhush-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
