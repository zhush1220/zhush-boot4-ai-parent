<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zhush</groupId>
        <artifactId>zhush-framework</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>zhush-spring-boot-starter-web</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.zhush</groupId>
            <artifactId>zhush-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@Valid / @Validated -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP：操作日志切面 @OperateLog（Boot4 已移除 starter-aop，直接引入 aspectjweaver） -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <!-- Sa-Token 异常处理（可选，仅在项目引入 Sa-Token 时生效）-->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 数据访问异常处理（可选，仅在项目引入数据库 starter 时生效）-->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 接口文档：Knife4j Boot 4 适配版（基于 SpringDoc OpenAPI3，自带 springdoc，版本由 zhush-dependencies 锁定）-->
        <dependency>
            <groupId>com.baizhukui</groupId>
            <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>
</project>
