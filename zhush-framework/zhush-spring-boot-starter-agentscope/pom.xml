<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zhush</groupId>
        <artifactId>zhush-framework</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>zhush-spring-boot-starter-agentscope</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.zhush</groupId>
            <artifactId>zhush-common</artifactId>
        </dependency>

        <!-- Redis：会话状态/审批队列分布式存储（RedisCache 封装） -->
        <dependency>
            <groupId>com.zhush</groupId>
            <artifactId>zhush-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- AgentScope 核心：harness 自动引入 core -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>

        <!-- 模型扩展：默认全量引入，运行时按配置启用（与 starter-search 同思路） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-ollama</artifactId>
        </dependency>

        <!-- Redis 状态后端（会话持久化） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-redis</artifactId>
        </dependency>

        <!-- 自动装配支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- 流式：Reactor（SSE 事件流） -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- 测试基础设施（JUnit5 + Mockito + AssertJ） -->
        <dependency>
            <groupId>com.zhush</groupId>
            <artifactId>zhush-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
