# zhush-server 容器环境变量模板：复制为 deploy/backend/.env 后填值（.env 含真实口令，不入库）。
# 键集与 application-docker.yaml 的 ${VAR:default} 占位一一对应；compose 经 env_file 注入容器。
# 语法纪律：KEY=VALUE，注释单独成行（值里带 # 会被 compose 的 dotenv 解析器当行尾注释截掉）。
# 「留空」与「注释掉」不等价：yaml 里 ${VAR:default} 只在变量未定义时取 default，定义为空串则取空串。
#   默认值为空的键留空即可；默认值非空的键（ES_URIS、SM4_KEY、PREVIEW_BASE_URL 等）想沿用默认就整行注释。

# ---- 时区 / 服务端口（镜像 ENTRYPOINT 已固定 -Dspring.profiles.active=docker）----
TZ=Asia/Shanghai
SERVER_PORT=9199

# ---- 上传大小：前两项是 multipart 限制，MAX_SIZE 是 zhush.file.max-size（字节），三者需自洽 ----
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=100MB
MAX_SIZE=52428800

# ---- Redis：starter-redis / Redisson / Sa-Token 会话共用；host 网络下用网关地址而非服务名 ----
REDIS_HOST=172.17.0.1
REDIS_PORT=6379
REDIS_DATABASE=8
REDIS_PASSWORD=

# ---- MySQL 主库（业务库）----
MYSQL_HOST=172.17.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=zhush_union
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ---- 从库（只在启用读写分离时放开；yaml 中 slave 数据源整段注释，放开此处也不会生效）----
#SLAVE_HOST=mysql
#SLAVE_PORT=3306
#SLAVE_DATABASE=zhush_slave
#SLAVE_USERNAME=readonly
#SLAVE_PASSWORD=

# ---- 认证与加解密 ----
# access-token 有效期（秒），靠 /admin/auth/refresh 无感续期
SA_TOKEN_TIMEOUT=7200
# 可选：不配则走 SmUtils 默认密钥策略；配置必须是 16 字节，留空反而会让密钥解析失败，所以整行注释
#SM4_KEY=

# ---- Sa-Token 拦截器路径前缀（含 context-path=/api，改动需与后端路由口径一致）----
SECURITY_ADMIN_PREFIX=/api/admin/**
SECURITY_MEMBER_PREFIX=/api/member/**

# ---- 跨域：前端经 nginx 同源代理时通常无需放开；生产建议收敛为具体域名 ----
CORS_ALLOWED_ORIGINS=

# ---- 路径（均为容器内路径，由 compose 的 volumes 持久化）----
LOG_DIR=/data/logs
FILE_BASE_PATH=/data/upload
# 文件访问 URL 前缀，后端 context-path=/api，静态资源实际暴露在 /api/files/
FILE_DOMAIN=/api/files/

# ---- SQL 审计（容器默认降噪）----
SQL_AUDIT_ENABLED=true
SQL_AUDIT_BATCH_SIZE=100
SQL_AUDIT_SAMPLE_RATE=10
SQL_AUDIT_ONLY_WRITE=true
SQL_AUDIT_SLOW_SQL_THRESHOLD=0

# ---- 会话产物在线预览（方案 docs/AI智能助手文件预览功能方案.md）----
# 档位三选一：none=纯前端路线乙 / libreoffice=甲-1（镜像需 --build-arg WITH_LIBREOFFICE=true）/ kkfileview=甲-2（另起 deploy/kkfileview）
PREVIEW_ENABLED=true
PREVIEW_OFFICE_CONVERTER=none
PREVIEW_SOFFICE_PATH=soffice
PREVIEW_CACHE_PATH=/data/preview-cache
# 每个 soffice 峰值约 300～500MB RSS，按主机余量取值
PREVIEW_MAX_CONCURRENT=1
PREVIEW_CONVERT_TIMEOUT=60
# 以下三项仅 office-converter=kkfileview 需要，取值口径见 deploy/kkfileview/docker-compose.yaml 与 deploy/nginx/default.conf
# 同源经 nginx 的预览前缀
#PREVIEW_BASE_URL=/preview
# kkFileView 容器解析不了 FILE_DOMAIN 那个相对前缀，回源用的绝对前缀必须由这里给出
#PREVIEW_SOURCE_BASE_URL=
# 可达性探测地址：配了才会在服务挂掉时回落「仅下载」
#PREVIEW_PROBE_URL=
# 回答正文引用文件登记（方案第十六章）
PREVIEW_ANSWER_FILE_ENABLED=true
# 默认按 WORKDIR /zhush-server 解析；要跨重启留存需挂 agentscope-workspace 卷（见 compose 的 volumes）
PREVIEW_ANSWER_FILE_WORKSPACE_ROOT=.agentscope/workspace
PREVIEW_ANSWER_FILE_MAX_SIZE=20971520

# ---- 全文搜索：zhush.search.enabled 在 yaml 里是字面 false，只放开这里不会启用 ----
#ES_URIS=http://localhost:9200

# ---- 消息队列：yaml 中整段注释，启用需同时改 zhush.mq.enabled ----
#MQ_NAMESRV_ADDR=127.0.0.1:9876

# ---- 模型供应商 Key（AgentScope）：留空则对应模型不可用 ----
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# ---- Jev 判断模型（TypeSafe AI）：关闭或无 Key 时相关能力自动降级，不报错 ----
JEV_ENABLED=false
TYPESAFE_API_KEY=

# ---- 联网搜索：provider 可选 iqs / tavily / mock（仅联调）；Key 仅环境变量注入，禁止入库与落日志 ----
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=iqs
WEB_SEARCH_API_KEY=

# ---- 微信支付：总开关关闭时不装配任何支付 Bean；启用 V3/V2 前必须配齐凭证，缺失将 fail-fast 启动失败 ----
WX_PAY_ENABLED=false
WX_PAY_MCH_ID=
WX_PAY_NOTIFY_URL=
WX_PAY_V3_ENABLED=false
WX_PAY_V3_APP_ID=
WX_PAY_V3_MCH_ID=
WX_PAY_V3_API_KEY=
WX_PAY_V3_CERT_SERIAL_NO=
WX_PAY_V3_PRIVATE_KEY_PATH=
WX_PAY_V3_PUBLIC_KEY_ID=
WX_PAY_V3_PUBLIC_KEY_PATH=
WX_PAY_V3_TRANSFER_SCENE_ID=
WX_PAY_V3_RECV_PERCEPTION=
WX_PAY_V3_RECEIPT_AUTH_MODE=
WX_PAY_V3_MIN_AMOUNT=1
WX_PAY_V3_MAX_AMOUNT=2000000
WX_PAY_V2_ENABLED=false
WX_PAY_V2_APP_ID=
WX_PAY_V2_MCH_ID=
WX_PAY_V2_MCH_KEY=
WX_PAY_V2_ENT_PAY_KEY=
WX_PAY_V2_KEY_PATH=
WX_PAY_V2_SIGN_TYPE=HMAC-SHA256
WX_PAY_V2_MIN_AMOUNT=1
WX_PAY_V2_MAX_AMOUNT=5000000
